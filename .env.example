# Supabase project credentials (Settings → API)
# Public — safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER expose to the browser or commit a real value.
# Used to mint short-lived signed URLs for sermon audio and to run
# `npm run upload:audio`. Found under Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe billing (server-only). Get keys at dashboard.stripe.com.
#
# Switching test <-> live is a single flag: set STRIPE_MODE and the app reads
# the matching *_TEST / *_LIVE values below. Leave STRIPE_MODE unset (or "test")
# to stay in test mode. You can keep BOTH sets defined at once — flipping the
# flag never overwrites the other environment's keys.
STRIPE_MODE=test

# --- Test mode (safe, uses Stripe test cards) ---
STRIPE_SECRET_KEY_TEST=sk_test_...
STRIPE_WEBHOOK_SECRET_TEST=whsec_...
STRIPE_PRICE_DEVOTED_TEST=price_...
STRIPE_PRICE_PATRON_TEST=price_...

# --- Live mode (real charges) ---
STRIPE_SECRET_KEY_LIVE=sk_live_...
STRIPE_WEBHOOK_SECRET_LIVE=whsec_...
STRIPE_PRICE_DEVOTED_LIVE=price_...
STRIPE_PRICE_PATRON_LIVE=price_...

# Legacy fallback: if the *_TEST / *_LIVE vars above are absent, the app falls
# back to these unsuffixed names (still fully supported).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_DEVOTED=price_...
# STRIPE_PRICE_PATRON=price_...

# Optional salt for hashing client IPs in the stream throttle table. Any random
# string; changing it just resets existing per-IP counters.
STREAM_IP_SALT=change-me

# --- Content ingestion (automated churches/pastors/sermons) ---
# Protects the daily cron endpoint /api/cron/ingest. Vercel Cron sends this as
# "Authorization: Bearer <CRON_SECRET>". Required for the daily job to run.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# OpenAI — powers episode summaries/scripture/tags + brand-colour theming from
# artwork. Get a key at platform.openai.com/api-keys. Optional: without it,
# ingestion still runs using simple heuristics (less polished metadata).
OPENAI_API_KEY=
# Optional: override the model (default gpt-4o-mini).
# OPENAI_MODEL=gpt-4o-mini

# Resend — sends the weekly digest email (Sunday cron /api/cron/digest).
# Get a key at resend.com; RESEND_FROM must use a domain verified in Resend
# (e.g. "iWord <digest@yourdomain.com>"). Optional: without both values the
# digest cron skips cleanly and signups are still stored.
RESEND_API_KEY=
RESEND_FROM=

# Podcast Index — OPTIONAL enhancement for discovery. Feed discovery already
# works for free with no key via Apple's iTunes Search API; setting these just
# switches discovery to Podcast Index (richer metadata). Note: Podcast Index
# signup may reject free email providers. Credentials at api.podcastindex.org.
PODCAST_INDEX_KEY=
PODCAST_INDEX_SECRET=
# Optional: comma-separated terms the daily job searches to discover new feeds.
# INGEST_DISCOVERY_TERMS=sermon,gospel,bible teaching

