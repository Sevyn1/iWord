# Supabase project credentials (Settings → API)
# Public — safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER expose to the browser or commit a real value.
# Used to mint short-lived signed URLs for sermon audio and to run
# `npm run upload:audio`. Found under Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe billing (server-only). Get keys at dashboard.stripe.com (test mode).
STRIPE_SECRET_KEY=sk_test_...
# From the Stripe CLI (`stripe listen`) or the webhook endpoint in the dashboard.
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ids printed by `npm run setup:stripe`.
STRIPE_PRICE_DEVOTED=price_...
STRIPE_PRICE_PATRON=price_...

